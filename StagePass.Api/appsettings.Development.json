{
  // The connection string is NOT stored here. Set it via User Secrets:
  //   dotnet user-secrets init --project StagePass.Api
  //   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "<dev-connection-string>" --project StagePass.Api
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  // Rate limiting is disabled in Development so the /demo.html concurrency
  // test can send hundreds of requests from a single browser IP.
  // It is ON in Production (appsettings.json).
  "RateLimiting": {
    "BookingEnabled": "false"
  }
}
